<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Router — Chat</title>
<style><%- stylesheet %></style>
<script><%- theme_script %></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="topbar">
<a class="brand" href="/chat"><span class="brand-mark" aria-hidden="true">R</span>AI Router <span class="badge">Chat</span></a>
<div class="toolbar">
<span class="chat-user"><%= username %></span>
<label class="theme-control">Theme <select id="theme" aria-label="Color theme"><option value="system">System</option><option value="dark">Dark</option><option value="light">Light</option></select></label>
<form class="inline" method="post" action="/chat/logout">
<input type="hidden" name="csrf_token" value="<%= csrf_token %>">
<button class="quiet" type="submit">Sign out</button>
</form>
</div>
</header>
<main id="main" class="chat-main">
<div class="chat-model-bar">
<label for="chat-model">Model</label>
<select id="chat-model"<% if #models == 0 then %> disabled<% end %>>
<% if #models == 0 then %>
<option value="">None available</option>
<% else %>
<% for _, model in ipairs(models) do %>
<option value="<%= model %>"><%= model %></option>
<% end %>
<% end %>
</select>
<% if #models == 0 then %><span class="muted">Ask your operator to grant you a model on a GLM or compatible channel.</span><% end %>
</div>
<div id="chat-messages" class="chat-messages">
<% if #models == 0 then %>
<div class="notice">No Chat Completions models are available to you yet. Models served only through the native Responses protocol cannot be used in this web chat.</div>
<% end %>
</div>
<p id="chat-error" class="error" role="status"></p>
<div class="chat-composer">
<textarea id="chat-input" rows="2" placeholder="Message — Enter to send, Shift+Enter for a new line"<% if #models == 0 then %> disabled<% end %>></textarea>
<button id="chat-send" type="button"<% if #models == 0 then %> disabled<% end %>>Send</button>
</div>
<p class="chat-hint">GLM and compatible models only. Conversations stay in this browser; the router stores the same request metadata as for API calls.</p>
</main>
<script>window.routerChat = <%- config %></script>
<script><%- page_script %></script>
</body>
</html>
